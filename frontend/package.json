{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "prebuild": "npm run check:encoding && npm run check:layers",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "pretest": "npm run check:encoding && npm run check:layers",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "apk:sync": "npm run build && cap sync android",
    "apk:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.77.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.10.1",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^3.6.0",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "dompurify": "^3.4.18",
    "follow-redirects": "^1.16.3"
  }
}
