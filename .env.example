# DATABASE (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=helpdesk_db
DB_USERNAME=root
DB_PASSWORD=root

# SPRING BOOT CONFIG
SERVER_PORT=8080
# IMPORTANTE: genera tu propio secreto (64 caracteres) y NO lo compartas.
# PowerShell:  $b=New-Object byte[] 48; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b).Replace('+','x').Replace('/','y').Replace('=','z')
JWT_SECRET=genera_un_secreto_aleatorio_de_64_caracteres_y_cambialo_aqui
JWT_EXPIRATION=86400000

# SEGURIDAD
# Origenes permitidos para CORS (separados por coma). En produccion definir la URL real.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Habilita/deshabilita Swagger. En produccion poner false.
SWAGGER_ENABLED=true

# MAIL CONFIG - Opcion A: Gmail real (produccion/demo real)
# Requiere App Password de 16 caracteres: https://myaccount.google.com/apppasswords
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=ivanechajay07@gmail.com
#MAIL_PASSWORD=abcdefghijklmnop

# MAIL CONFIG - Opcion B: Mailpit para desarrollo (visor en http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Correo del administrador que recibe las notificaciones del sistema
ADMIN_EMAIL=ivanechajay07@gmail.com
# Contrasena inicial del usuario admin. En produccion define una fuerte y unica.
ADMIN_PASSWORD=admin123

# FILE STORAGE
UPLOAD_DIR=./uploads

# URL publica usada para generar el QR del inventario (debe ser accesible desde
# el dispositivo que escanea, p. ej. http://192.168.1.10:5173). Si se deja vacio
# se usa el origen del navegador.
VITE_PUBLIC_APP_URL=

# Monitoreo de red: permitir destinos internos (192.168.x, 10.x, localhost). Por defecto true.
MONITORING_ALLOW_PRIVATE=true

# URL publica del frontend usada en los enlaces de los correos
# (restablecer contraseña). Debe ser la direccion con la que accedes al sistema.
# Si accedes por IP o dominio, coloca aqui esa direccion (p. ej. http://192.168.1.10:5173).
FRONTEND_URL=http://localhost:5173
