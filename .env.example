# DATABASE (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=helpdesk_db
# Backend de desarrollo local (mvn spring-boot:run)
DB_USERNAME=root
DB_PASSWORD=root

# Credenciales del stack Docker: usuario de aplicacion (nunca root).
# Define valores fuertes y distintos a los de desarrollo.
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_APP_USER=helpdesk
DB_APP_PASSWORD=cambia_esta_clave_de_aplicacion
# Pool de conexiones para varios usuarios concurrentes.
DB_POOL_MAX=20
DB_POOL_MIN=5

# Mirror opcional para builds Docker si Maven Central falla (429/404).
# MAVEN_MIRROR_URL=https://maven-central.storage-download.googleapis.com/maven2/

# PostgreSQL / Supabase (perfil "postgres")
# Descomenta y ajusta para desplegar con Supabase:
# SPRING_PROFILES_ACTIVE=postgres
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=...
# DB_SSLMODE=require

# SPRING BOOT CONFIG
SERVER_PORT=8080
# IMPORTANTE: genera tu propio secreto (64 caracteres) y NO lo compartas.
# PowerShell:  $b=New-Object byte[] 48; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b).Replace('+','x').Replace('/','y').Replace('=','z')
JWT_SECRET=genera_un_secreto_aleatorio_de_64_caracteres_y_cambialo_aqui
# Access token corto: el frontend lo renueva con el refresh token.
JWT_EXPIRATION=1800000

# Bloqueo temporal tras intentos fallidos y cierre por inactividad.
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
# Límite por IP (oficinas detrás de NAT) y ventana en segundos.
LOGIN_IP_ATTEMPTS=120
LOGIN_IP_WINDOW_SECONDS=60
IDLE_TIMEOUT_MINUTES=15
# Tiempo de inactividad del frontend (minutos). Se aplica al compilar.
VITE_IDLE_TIMEOUT_MINUTES=15

# Antivirus opcional (ClamAV). Vacio = sin escaneo. En produccion: host=clamav,
# CLAMAV_FAIL_CLOSED=true para rechazar archivos si el antivirus no responde.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=false

# Contrasena inicial del admin. OBLIGATORIA: el backend no arranca con "admin123".
ADMIN_PASSWORD=cambia_esta_contrasena_fuerte
# Solo desarrollo local: permite arrancar con admin123. Nunca en produccion.
ALLOW_DEFAULT_ADMIN_PASSWORD=false

# SEGURIDAD
# Origenes permitidos para CORS (separados por coma). En produccion definir la URL real.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# 0.0.0.0 = accesible desde otros dispositivos de la LAN; 127.0.0.1 = solo este equipo.
FRONTEND_BIND=0.0.0.0
# URL con la que abren el sistema los demas dispositivos (para enlaces de correo).
# Ejemplo: PUBLIC_FRONTEND_URL=http://192.168.1.50:5174
PUBLIC_FRONTEND_URL=http://localhost:5174
# Habilita/deshabilita Swagger. En produccion dejar false.
SWAGGER_ENABLED=false
# Cookie de refresh: true SOLO con HTTPS en produccion.
COOKIE_SECURE=false

# MAIL CONFIG - Opcion A: Gmail real (produccion/demo real)
# Requiere App Password de 16 caracteres: https://myaccount.google.com/apppasswords
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=soporte@example.com
#MAIL_PASSWORD=abcdefghijklmnop

# MAIL CONFIG - Opcion B: Mailpit para desarrollo (visor en http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Correo del administrador que recibe las notificaciones del sistema
ADMIN_EMAIL=admin@example.com
# Contrasena inicial del usuario admin (ver ADMIN_PASSWORD arriba).
# ADMIN_PASSWORD=cambia_esta_contrasena_fuerte

# FILE STORAGE
UPLOAD_DIR=./uploads

# URL publica usada para generar el QR del inventario (debe ser accesible desde
# el dispositivo que escanea, p. ej. http://192.168.1.10:5173). Si se deja vacio
# se usa el origen del navegador.
VITE_PUBLIC_APP_URL=

# Monitoreo de red: permitir destinos internos (192.168.x, 10.x, localhost). Por defecto true.
MONITORING_ALLOW_PRIVATE=true

# URL publica del frontend usada en los enlaces de los correos
# (restablecer contraseña). Debe ser la direccion con la que accedes al sistema.
# Si accedes por IP o dominio, coloca aqui esa direccion (p. ej. http://192.168.1.10:5173).
FRONTEND_URL=http://localhost:5173

# Si usas el override docker-compose.local.yml, el puerto es 5174 y ya se
# sobrescribe automaticamente.
